// Prisma schema — Ranenla Platform Data Engine

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ==========================================
// ENUMS & CONSTANTS
// ==========================================

enum Role {
  STUDENT
  TUTOR
  ADMIN
  BUYER
  VENDOR
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

enum SubmissionStatus {
  PENDING
  GRADED
}

enum EventType {
  CLASS
  ASSIGNMENT
  EXAM
  AI_SESSION
  OTHER
}

enum MessageRole {
  USER
  ASSISTANT
}

enum ActivityType {
  QUIZ_COMPLETE
  NOTE_UPLOAD
  BADGE_EARNED
  LESSON_COMPLETE
  ASSIGNMENT_SUBMITTED
  LOGIN
  LOGOUT
  TOKEN_REFRESH
  PASSWORD_CHANGE
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_COMPLETE
}

enum VendorApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}


// ==========================================
// 1. USER & AUTH MODULE
// ==========================================

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  fullName      String
  avatarUrl     String?
  role          Role           @default(STUDENT)
  bio           String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  buyerProfile  BuyerProfile?
  vendorProfile VendorProfile?

  preferences      UserPreferences?
  refreshTokens    RefreshToken[]
  enrollments      Enrollment[]
  attendanceLogs   AttendanceLog[]
  streak           UserStreak?
  submissions      Submission[]
  achievements     UserAchievement[]
  calendarEvents   CalendarEvent[]
  aiChatMessages   AiChatMessage[]
  activityLogs     ActivityLog[]
  sentMessages     Message[]         @relation("SentMessages")
  receivedMessages Message[]         @relation("ReceivedMessages")
  groupMessages    GroupMessage[]

  @@map("users")
}

model UserPreferences {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme                String   @default("dark")
  language             String   @default("en")
  notificationsEnabled Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("user_preferences")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ==========================================
// 2. COURSE & LEARNING MODULE
// ==========================================

model Course {
  id             String   @id @default(cuid())
  title          String
  detailSlug     String   @unique // e.g. "database-101", "python-programming"
  description    String
  instructorName String // e.g. "Prof. Lucas (AI)"
  category       String // e.g. "Computer Science", "AI Engineering"
  level          String   @default("Beginner")
  bannerUrl      String? // e.g. "/course-database.png"
  icon           String? // e.g. "🗄️", "🌐", "</>"
  iconBg         String? // e.g. "bg-purple-900/30"
  rating         Float    @default(4.8)
  totalStudents  Int      @default(0)
  liveClassToday Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  modules        CourseModule[]
  enrollments    Enrollment[]
  attendanceLogs AttendanceLog[]
  assignments    Assignment[]
  calendarEvents CalendarEvent[]
  resources      CourseResource[]

  @@index([category])
  @@map("courses")
}

model CourseModule {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessons Lesson[]

  @@index([courseId])
  @@map("course_modules")
}

model Lesson {
  id        String       @id @default(cuid())
  moduleId  String
  module    CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title     String
  videoUrl  String?
  duration  String       @default("15 mins")
  order     Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([moduleId])
  @@map("lessons")
}

model CourseResource {
  id         String   @id @default(cuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title      String // e.g. "Database Normalization.pdf"
  fileUrl    String
  fileType   String   @default("pdf")
  uploadedAt DateTime @default(now())

  @@index([courseId])
  @@map("course_resources")
}

model Enrollment {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId        String
  course          Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progressPercent Float            @default(0.0) // 0 - 100 %
  status          EnrollmentStatus @default(ACTIVE)
  enrolledAt      DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("enrollments")
}

// ==========================================
// 3. ATTENDANCE & STREAK MODULE
// ==========================================

model AttendanceLog {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  date      DateTime
  status    AttendanceStatus @default(PRESENT)
  timeSlot  String? // e.g. "09:00 AM - 10:30 AM"
  topic     String? // e.g. "SQL Joins & Indexing"
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([courseId])
  @@map("attendance_logs")
}

model UserStreak {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak  Int       @default(0) // e.g. 7 Days
  bestStreak     Int       @default(0) // e.g. 18 Days
  lastActiveDate DateTime?
  updatedAt      DateTime  @updatedAt

  @@map("user_streaks")
}

// ==========================================
// 4. ASSIGNMENTS & SUBMISSIONS MODULE
// ==========================================

model Assignment {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String
  dueDate     DateTime
  totalPoints Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  submissions Submission[]

  @@index([courseId])
  @@map("assignments")
}

model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  content      String?
  fileUrl      String?
  status       SubmissionStatus @default(PENDING)
  score        Int?
  feedback     String?
  submittedAt  DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([assignmentId, userId])
  @@index([userId])
  @@index([assignmentId])
  @@map("submissions")
}

// ==========================================
// 5. ACHIEVEMENTS, CALENDAR & ACTIVITY FEED
// ==========================================

model Achievement {
  id          String   @id @default(cuid())
  title       String // e.g. "Perfect Attendance"
  description String
  icon        String // e.g. "Award", "Flame", "Star"
  category    String   @default("General")
  xpPoints    Int      @default(50)
  createdAt   DateTime @default(now())

  users UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

model CalendarEvent {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String?
  course    Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  title     String // e.g. "Database 101"
  startTime DateTime
  endTime   DateTime
  type      EventType @default(CLASS)
  location  String?
  isLive    Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("calendar_events")
}

model ActivityLog {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String // e.g. 'You completed "SQL Basics Quiz"'
  subtitle  String? // e.g. "Database Normalization.pdf"
  type      ActivityType @default(LESSON_COMPLETE)
  createdAt DateTime     @default(now())

  @@index([userId])
  @@map("activity_logs")
}

// ==========================================
// 6. AI TUTOR & MESSAGING MODULE
// ==========================================

model AiChatMessage {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      MessageRole @default(USER)
  content   String
  createdAt DateTime    @default(now())

  @@map("ai_chat_messages")
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("messages")
}

model GroupMessage {
  id        String   @id @default(cuid())
  channelId String
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@map("group_messages")
}

// ==========================================
// 7. BUYER PROFILE MODEL
// ==========================================

model BuyerProfile {
  id      String  @id @default(cuid())
  userId  String  @unique
  address String? @default("")
  picture String?

  // Added opposite side relations for marketplace models
  carts          Cart[]
  orders         Order[]
  ratings        Rating[]
  returnRequests ReturnRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// 8. VENDOR PROFILE MODEL
// ==========================================

model VendorProfile {
  id     String @id @default(cuid())
  userId String @unique

  // Business Information
  contact                    String
  businessName               String
  proof                      String
  location                   String
  currentState               String
  businessRegistrationNumber String

  // Images
  vendorPicture   String
  businessPicture String

  // Approval Workflow
  approvalStatus  VendorApprovalStatus @default(PENDING)
  rejectionReason String?
  reviewedAt      DateTime?

  // Audit Fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  //product sold by vendor
  products Product[]

  // Categories the vendor belongs to (many-to-many)
  categories ProductCategory[] @relation("VendorCategories")
}

// ==========================================
// 9. PRODUCT CATEGORY MODEL
// ==========================================
// Categories are managed dynamically by the admin.
// Supports unlimited categories and subcategories.

model ProductCategory {
  /// Primary Key
  id String @id @default(cuid())

  /// Category Information
  name        String
  slug        String @unique
  description String?
  icon   String?

  /// Category Status
  isActive Boolean @default(true)

  /// Parent Category (Optional)
  parentId String?

  parent ProductCategory? @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children ProductCategory[] @relation("CategoryHierarchy")

  /// Products inside this category
  products Product[]
  vendors VendorProfile[] @relation("VendorCategories")
  /// Audit Fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Indexes
  @@index([parentId])
  @@index([slug])

  @@map("product_categories")
}

/// ==========================================
// 10. PRODUCT MODEL
// ==========================================
// A product belongs to one vendor and one category.
// Supports future marketplace expansion.

model Product {

  /// Primary Key
  id String @id @default(cuid())

  // ===================================================
  // Relationships
  // ===================================================

  /// Vendor
  vendorId String

  vendor VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  /// Category
  categoryId String

  category ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // ===================================================
  // Product Information
  // ===================================================

  name String

  slug String @unique

  shortDescription String?

  description String

  // ===================================================
  // Pricing
  // ===================================================

  price Decimal @db.Decimal(10,2)

  // Opposite side relations for marketplace models
  cartItems CartItem[]
  orderItems OrderItem[]
  ratings Rating[]

  discountPrice Decimal? @db.Decimal(10,2)

  // ===================================================
  // Inventory
  // ===================================================

  stock Int

  sku String?

  // ===================================================
  // Media
  // ===================================================

  images ProductImage[]

  // ===================================================
  // Status
  // ===================================================

  isFeatured Boolean @default(false)

  isActive Boolean @default(true)

  // ===================================================
  // Audit
  // ===================================================

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // ===================================================
  // Indexes
  // ===================================================

  @@index([vendorId])

  @@index([categoryId])

  @@index([name])

  @@index([slug])

  @@index([isActive])

  @@map("products")
}

// ---------------------------------------------------
// ProductImage model – separate from Product
// ---------------------------------------------------
model ProductImage {
  id          String   @id @default(cuid())
  productId   String
  imageUrl    String
  isPrimary   Boolean  @default(false)
  displayOrder Int     @default(0)
  createdAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ---------------------------------------------------
// Marketplace Cart & Order models (Phase 5)
// ---------------------------------------------------
model Cart {
  id        String   @id @default(cuid())
  buyerId   String   @unique
  buyer     BuyerProfile @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int @default(1)
  @@unique([cartId, productId])
}

model Order {
  id           String   @id @default(cuid())
  buyerId      String
  buyer        BuyerProfile @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  totalAmount  Decimal   @db.Decimal(10,2)
  status       String    @default("PENDING")
  paymentStatus String   @default("PENDING")
  paymentReference String? @unique
  paymentMethod String?
  shippingAddress String?
  items        OrderItem[]
  paymentEvents PaymentWebhookEvent[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int @default(1)
  priceAtPurchase Decimal @db.Decimal(10,2)
  status    String @default("PENDING")

  // Opposite side relation for returns
  returnRequests ReturnRequest[]
}

model Rating {
  id        String   @id @default(cuid())
  buyerId   String
  buyer     BuyerProfile @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  rating    Int @default(5) // 1‑5
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([buyerId, productId])
}

model ReturnRequest {
  id            String   @id @default(cuid())
  orderItemId   String
  orderItem     OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  buyerId       String
  buyer         BuyerProfile @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  reason        String
  status        String @default("PENDING")
  trackingId    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([buyerId, orderItemId])
}

model PaymentWebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      String
  signature   String
  receivedAt  DateTime @default(now())

  @@index([orderId])
}
