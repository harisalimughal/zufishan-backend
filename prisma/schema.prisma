// Prisma schema — Ranenla Platform Data Engine

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

// ==========================================
// ENUMS & CONSTANTS
// ==========================================

enum Role {
  STUDENT
  TUTOR
  ADMIN
  BUYER
  VENDOR
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

enum SubmissionStatus {
  PENDING
  GRADED
}

enum EventType {
  CLASS
  ASSIGNMENT
  EXAM
  AI_SESSION
  OTHER
}

enum MessageRole {
  USER
  ASSISTANT
}

enum ActivityType {
  QUIZ_COMPLETE
  NOTE_UPLOAD
  BADGE_EARNED
  LESSON_COMPLETE
  ASSIGNMENT_SUBMITTED
  LOGIN
  LOGOUT
  TOKEN_REFRESH
  PASSWORD_CHANGE
  PASSWORD_RESET_REQUEST
  PASSWORD_RESET_COMPLETE
}

enum VendorApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}


// ==========================================
// 1. USER & AUTH MODULE
// ==========================================

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  fullName      String
  avatarUrl     String?
  role          Role           @default(STUDENT)
  bio           String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  buyerProfile  BuyerProfile?
  vendorProfile VendorProfile?

  preferences      UserPreferences?
  refreshTokens    RefreshToken[]
  enrollments      Enrollment[]
  attendanceLogs   AttendanceLog[]
  streak           UserStreak?
  submissions      Submission[]
  achievements     UserAchievement[]
  calendarEvents   CalendarEvent[]
  aiChatMessages   AiChatMessage[]
  activityLogs     ActivityLog[]
  sentMessages     Message[]         @relation("SentMessages")
  receivedMessages Message[]         @relation("ReceivedMessages")
  groupMessages    GroupMessage[]

  // ── Utilities Module relations ──
  zakatCalculations        ZakatCalculation[]
  tasbihSessions           TasbihSession[]
  aiAssistantConversations AiAssistantConversation[]

  @@map("users")
}

model UserPreferences {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme                String   @default("dark")
  language             String   @default("en")
  notificationsEnabled Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("user_preferences")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// ==========================================
// 2. COURSE & LEARNING MODULE
// ==========================================

model Course {
  id             String   @id @default(cuid())
  title          String
  detailSlug     String   @unique // e.g. "database-101", "python-programming"
  description    String
  instructorName String // e.g. "Prof. Lucas (AI)"
  category       String // e.g. "Computer Science", "AI Engineering"
  level          String   @default("Beginner")
  bannerUrl      String? // e.g. "/course-database.png"
  icon           String? // e.g. "🗄️", "🌐", "</>"
  iconBg         String? // e.g. "bg-purple-900/30"
  rating         Float    @default(4.8)
  totalStudents  Int      @default(0)
  liveClassToday Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  modules        CourseModule[]
  enrollments    Enrollment[]
  attendanceLogs AttendanceLog[]
  assignments    Assignment[]
  calendarEvents CalendarEvent[]
  resources      CourseResource[]

  @@index([category])
  @@map("courses")
}

model CourseModule {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lessons Lesson[]

  @@index([courseId])
  @@map("course_modules")
}

model Lesson {
  id        String       @id @default(cuid())
  moduleId  String
  module    CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title     String
  videoUrl  String?
  duration  String       @default("15 mins")
  order     Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([moduleId])
  @@map("lessons")
}

model CourseResource {
  id         String   @id @default(cuid())
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title      String // e.g. "Database Normalization.pdf"
  fileUrl    String
  fileType   String   @default("pdf")
  uploadedAt DateTime @default(now())

  @@index([courseId])
  @@map("course_resources")
}

model Enrollment {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId        String
  course          Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progressPercent Float            @default(0.0) // 0 - 100 %
  status          EnrollmentStatus @default(ACTIVE)
  enrolledAt      DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("enrollments")
}

// ==========================================
// 3. ATTENDANCE & STREAK MODULE
// ==========================================

model AttendanceLog {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  date      DateTime
  status    AttendanceStatus @default(PRESENT)
  timeSlot  String? // e.g. "09:00 AM - 10:30 AM"
  topic     String? // e.g. "SQL Joins & Indexing"
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([courseId])
  @@map("attendance_logs")
}

model UserStreak {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak  Int       @default(0) // e.g. 7 Days
  bestStreak     Int       @default(0) // e.g. 18 Days
  lastActiveDate DateTime?
  updatedAt      DateTime  @updatedAt

  @@map("user_streaks")
}

// ==========================================
// 4. ASSIGNMENTS & SUBMISSIONS MODULE
// ==========================================

model Assignment {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String
  dueDate     DateTime
  totalPoints Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  submissions Submission[]

  @@index([courseId])
  @@map("assignments")
}

model Submission {
  id           String           @id @default(cuid())
  assignmentId String
  assignment   Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  content      String?
  fileUrl      String?
  status       SubmissionStatus @default(PENDING)
  score        Int?
  feedback     String?
  submittedAt  DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([assignmentId, userId])
  @@index([userId])
  @@index([assignmentId])
  @@map("submissions")
}

// ==========================================
// 5. ACHIEVEMENTS, CALENDAR & ACTIVITY FEED
// ==========================================

model Achievement {
  id          String   @id @default(cuid())
  title       String // e.g. "Perfect Attendance"
  description String
  icon        String // e.g. "Award", "Flame", "Star"
  category    String   @default("General")
  xpPoints    Int      @default(50)
  createdAt   DateTime @default(now())

  users UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId])
  @@map("user_achievements")
}

model CalendarEvent {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String?
  course    Course?   @relation(fields: [courseId], references: [id], onDelete: SetNull)
  title     String // e.g. "Database 101"
  startTime DateTime
  endTime   DateTime
  type      EventType @default(CLASS)
  location  String?
  isLive    Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("calendar_events")
}

model ActivityLog {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String // e.g. 'You completed "SQL Basics Quiz"'
  subtitle  String? // e.g. "Database Normalization.pdf"
  type      ActivityType @default(LESSON_COMPLETE)
  createdAt DateTime     @default(now())

  @@index([userId])
  @@map("activity_logs")
}

// ==========================================
// 6. AI TUTOR & MESSAGING MODULE
// ==========================================

model AiChatMessage {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      MessageRole @default(USER)
  content   String
  createdAt DateTime    @default(now())

  @@map("ai_chat_messages")
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("messages")
}

model GroupMessage {
  id        String   @id @default(cuid())
  channelId String
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())

  @@map("group_messages")
}

// ==========================================
// 7. BUYER PROFILE MODEL
// ==========================================

model BuyerProfile {
  id      String  @id @default(cuid())
  userId  String  @unique
  address String? @default("")
  picture String?

  // Added opposite side relations for marketplace models
  carts          Cart[]
  orders         Order[]
  ratings        Rating[]
  returnRequests ReturnRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// 8. VENDOR PROFILE MODEL
// ==========================================

model VendorProfile {
  id     String @id @default(cuid())
  userId String @unique

  // Business Information
  contact                    String
  businessName               String
  proof                      String
  location                   String
  currentState               String
  businessRegistrationNumber String

  // Images
  vendorPicture   String
  businessPicture String

  // Approval Workflow
  approvalStatus  VendorApprovalStatus @default(PENDING)
  rejectionReason String?
  reviewedAt      DateTime?

  // Audit Fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  //product sold by vendor
  products Product[]

  // Categories the vendor belongs to (many-to-many)
  categories ProductCategory[] @relation("VendorCategories")
}

// ==========================================
// 9. PRODUCT CATEGORY MODEL
// ==========================================
// Categories are managed dynamically by the admin.
// Supports unlimited categories and subcategories.

model ProductCategory {
  /// Primary Key
  id String @id @default(cuid())

  /// Category Information
  name        String
  slug        String @unique
  description String?
  icon   String?

  /// Category Status
  isActive Boolean @default(true)

  /// Parent Category (Optional)
  parentId String?

  parent ProductCategory? @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children ProductCategory[] @relation("CategoryHierarchy")

  /// Products inside this category
  products Product[]
  vendors VendorProfile[] @relation("VendorCategories")
  /// Audit Fields
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Indexes
  @@index([parentId])
  @@index([slug])

  @@map("product_categories")
}

/// ==========================================
// 10. PRODUCT MODEL
// ==========================================
// A product belongs to one vendor and one category.
// Supports future marketplace expansion.

model Product {

  /// Primary Key
  id String @id @default(cuid())

  // ===================================================
  // Relationships
  // ===================================================

  /// Vendor
  vendorId String

  vendor VendorProfile @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  /// Category
  categoryId String

  category ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // ===================================================
  // Product Information
  // ===================================================

  name String

  slug String @unique

  shortDescription String?

  description String

  // ===================================================
  // Pricing
  // ===================================================

  price Decimal @db.Decimal(10,2)

  // Opposite side relations for marketplace models
  cartItems CartItem[]
  orderItems OrderItem[]
  ratings Rating[]

  discountPrice Decimal? @db.Decimal(10,2)

  // ===================================================
  // Inventory
  // ===================================================

  stock Int

  sku String?

  // ===================================================
  // Media
  // ===================================================

  images ProductImage[]

  // ===================================================
  // Status
  // ===================================================

  isFeatured Boolean @default(false)

  isActive Boolean @default(true)

  // ===================================================
  // Audit
  // ===================================================

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  // ===================================================
  // Indexes
  // ===================================================

  @@index([vendorId])

  @@index([categoryId])

  @@index([name])

  @@index([slug])

  @@index([isActive])

  @@map("products")
}

// ---------------------------------------------------
// ProductImage model – separate from Product
// ---------------------------------------------------
model ProductImage {
  id          String   @id @default(cuid())
  productId   String
  imageUrl    String
  isPrimary   Boolean  @default(false)
  displayOrder Int     @default(0)
  createdAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ---------------------------------------------------
// Marketplace Cart & Order models (Phase 5)
// ---------------------------------------------------
model Cart {
  id        String   @id @default(cuid())
  buyerId   String   @unique
  buyer     BuyerProfile @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int @default(1)
  @@unique([cartId, productId])
}

model Order {
  id           String   @id @default(cuid())
  buyerId      String
  buyer        BuyerProfile @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  totalAmount  Decimal   @db.Decimal(10,2)
  status       String    @default("PENDING")
  paymentStatus String   @default("PENDING")
  paymentReference String? @unique
  paymentMethod String?
  shippingAddress String?
  items        OrderItem[]
  paymentEvents PaymentWebhookEvent[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity  Int @default(1)
  priceAtPurchase Decimal @db.Decimal(10,2)
  status    String @default("PENDING")

  // Opposite side relation for returns
  returnRequests ReturnRequest[]
}

model Rating {
  id        String   @id @default(cuid())
  buyerId   String
  buyer     BuyerProfile @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  rating    Int @default(5) // 1‑5
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([buyerId, productId])
}

model ReturnRequest {
  id            String   @id @default(cuid())
  orderItemId   String
  orderItem     OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  buyerId       String
  buyer         BuyerProfile @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  reason        String
  status        String @default("PENDING")
  trackingId    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([buyerId, orderItemId])
}

model PaymentWebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      String
  signature   String
  receivedAt  DateTime @default(now())

  @@index([orderId])
}

// ==========================================
// 8. DAILY UTILITIES MODULE
// ==========================================

enum AzkarCategory {
  MORNING
  EVENING
  SLEEP
  PRAYER
  GENERAL
}

enum AiAssistantRole {
  USER
  ASSISTANT
}

enum RagSourceType {
  HELP_DOC
  COURSE_METADATA
  MARKETPLACE_METADATA
  FAQ
}

// ── 7a. Prayer Time Cache ──────────────────
// Caches external API responses by location + date + method + asrMethod.
// Avoids repeated external calls for the same coordinates on the same day.
model PrayerTimeCache {
  id String @id @default(cuid())

  // Location stored as Decimal for full precision (avoid float rounding)
  latitude  Decimal @db.Decimal(9, 6)
  longitude Decimal @db.Decimal(9, 6)

  date      DateTime @db.Date   // date-only (no time component)
  method    String   @default("MWL")  // calculation method: MWL, ISNA, Egypt, Karachi …
  asrMethod Int      @default(0)      // 0 = Standard/Shafi'i, 1 = Hanafi

  // Prayer times stored as HH:MM strings (timezone-agnostic)
  fajr    String
  sunrise String
  dhuhr   String
  asr     String
  maghrib String
  isha    String

  // Optional extras some methods provide
  midnight  String?
  lastThird String?

  expiresAt DateTime // cache TTL — typically end of the cached day
  createdAt DateTime @default(now())

  // One cache entry per (location bucket + date + method + asrMethod)
  @@unique([latitude, longitude, date, method, asrMethod])
  @@index([expiresAt]) // for cache-expiry cleanup jobs
  @@map("prayer_time_cache")
}

// ── 7b. Zakat Nisab Rates ─────────────────
// Stores periodic gold/silver price snapshots used to determine nisab.
// Admin-managed; one record per currency per effective date.
model ZakatNisabRate {
  id String @id @default(cuid())

  // Prices per gram in the given currency
  goldPricePerGram   Decimal @db.Decimal(18, 6)
  silverPricePerGram Decimal @db.Decimal(18, 6)

  currency      String   @default("USD") @db.Char(3) // ISO 4217
  effectiveDate DateTime @db.Date

  // Nisab thresholds in grams (Islamic standard values)
  nisabGoldGrams   Decimal @default(85) @db.Decimal(8, 3)
  nisabSilverGrams Decimal @default(595) @db.Decimal(8, 3)

  // Computed nisab value = nisabGoldGrams * goldPricePerGram
  nisabValueGold   Decimal @db.Decimal(18, 4)
  nisabValueSilver Decimal @db.Decimal(18, 4)

  source    String? // e.g. "goldapi.io", "manual"
  createdAt DateTime @default(now())

  calculations ZakatCalculation[]

  @@unique([currency, effectiveDate])
  @@index([effectiveDate])
  @@map("zakat_nisab_rates")
}

// ── 7c. Zakat Calculations ────────────────
// Persists a user's zakat calculation result for record-keeping.
// userId is optional to allow guest/unauthenticated calculations.
model ZakatCalculation {
  id     String  @id @default(cuid())
  userId String? // nullable — guests can calculate without an account
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // User-provided asset values
  goldGrams      Decimal @default(0) @db.Decimal(12, 4)
  silverGrams    Decimal @default(0) @db.Decimal(12, 4)
  cashSavings    Decimal @default(0) @db.Decimal(18, 4)
  investments    Decimal @default(0) @db.Decimal(18, 4)
  businessAssets Decimal @default(0) @db.Decimal(18, 4)
  receivables    Decimal @default(0) @db.Decimal(18, 4)

  // Computed results
  totalZakatableAssets Decimal @db.Decimal(18, 4)
  nisabThreshold       Decimal @db.Decimal(18, 4)
  zakatDue             Decimal @db.Decimal(18, 4)
  zakatableAboveNisab  Boolean // false if assets < nisab

  currency    String          @default("USD") @db.Char(3)
  nisabRateId String? // snapshot of rates used
  nisabRate   ZakatNisabRate? @relation(fields: [nisabRateId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  // Composite: current-user history ordered by newest first
  @@index([userId, createdAt(sort: Desc)])
  @@map("zakat_calculations")
}

// ── 7d. Azkar Categories ─────────────────
// Admin-managed; defines the high-level groupings for azkar items.
model AzkarCategoryRecord {
  id           String   @id @default(cuid())
  slug         String   @unique // e.g. "morning", "evening"
  name         String // English label
  arabicName   String // e.g. "أذكار الصباح"
  description  String?
  iconName     String? // Lucide icon name for UI
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items AzkarItem[]

  @@index([isActive])
  @@map("azkar_categories")
}

// ── 7e. Azkar Items ───────────────────────
// Individual dhikr / supplication entries.
model AzkarItem {
  id         String              @id @default(cuid())
  categoryId String
  category   AzkarCategoryRecord @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  arabic          String // Full Arabic text
  transliteration String? // Romanised pronunciation
  translation     String // English meaning
  repetitions     Int      @default(1) // How many times to recite
  reference       String? // Source (e.g. "Sahih Bukhari 6311")
  audioUrl        String? // Optional hosted audio file URL
  displayOrder    Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive])
  @@map("azkar_items")
}

// ── 7f. Tasbih Sessions ───────────────────
// Persists a user's completed dhikr counter sessions.
model TasbihSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  phrase       String // e.g. "SubhanAllah" (transliteration or Arabic)
  arabicPhrase String? // Arabic text if different from phrase
  count        Int // Actual count achieved in session
  target       Int     @default(33) // Target count (33, 99, etc.)
  isCompleted  Boolean @default(false) // count >= target

  sessionDate DateTime @default(now()) @db.Date // which day the session belongs to
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([userId, sessionDate]) // efficient per-user daily history lookup
  @@map("tasbih_sessions")
}

// ── 7g. AI Assistant Conversations ───────
// Groups a series of messages into a single conversation thread.
model AiAssistantConversation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title     String? // Auto-generated from first message or user-set
  isActive  Boolean  @default(true)

  // Admin flagging — moderator can mark a conversation for human review
  isFlagged  Boolean   @default(false)
  flaggedAt  DateTime?
  flagReason String?   // e.g. "Inappropriate content", "Policy violation"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs AiAssistantLog[]

  @@index([userId])
  @@index([userId, isActive])              // filter active conversations per user
  @@index([userId, updatedAt])             // conversation ordering newest first
  @@index([userId, isActive, updatedAt])   // active conversations newest first
  @@index([isFlagged])                     // admin flagged conversations
  @@map("ai_assistant_conversations")
}

// ── 7h. AI Assistant Logs ─────────────────
// Individual message turns within a conversation.
// Kept separate from the Learning Platform's AiChatMessage model.
model AiAssistantLog {
  id             String                  @id @default(cuid())
  conversationId String
  conversation   AiAssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    AiAssistantRole // USER or ASSISTANT
  content String          // Full message text

  // ── Token accounting ─────────────────────────────────────────
  promptTokens     Int? // tokens in the user's prompt
  completionTokens Int? // tokens in the AI's response
  totalTokens      Int? // total billed tokens for this turn

  // ── AI provider metadata ──────────────────────────────────────
  modelUsed String? // e.g. "gemini-1.5-flash", "fiqhi-guardrail"
  latencyMs Int?    // response time in milliseconds

  // ── Topic / routing classification ───────────────────────────
  // Set by the guardrail classifiers before any LLM call.
  topicCategory String?  // FatwaCategory value: "PRAYER_WORSHIP", "FINANCIAL", etc.
  isRedirected  Boolean  @default(false) // true = fiqhi scholar redirect issued
  isAdversarial Boolean  @default(false) // true = adversarial bypass attempt detected
  isOutOfScope  Boolean  @default(false) // true = query had no relevant RAG results

  // ── Retrieval metadata ────────────────────────────────────────
  retrievedChunkCount Int?   // number of RAG chunks retrieved
  topSimilarityScore  Float? // highest cosine similarity score in the result set

  // ── Error / status tracking ───────────────────────────────────
  // null = success | "FIQHI_REDIRECT" | "SCOPE_REJECTED" | "TIMEOUT" |
  // "PROVIDER_ERROR" | "RATE_LIMITED"
  errorStatus String?

  // ── Admin flagging ────────────────────────────────────────────
  isFlagged Boolean @default(false) // admin flagged this turn for review

  // ── User feedback ──────────────────────────────────────────────
  rating          String?  // "helpful" | "not_helpful" | "inappropriate"
  feedbackComment String?  // optional free-text comment

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([conversationId, createdAt])   // chronological message fetch
  @@index([createdAt])                   // admin logs: newest first
  @@index([isRedirected])                // filter scholar redirects
  @@index([isAdversarial])               // filter adversarial attempts
  @@index([isOutOfScope])                // filter out-of-scope rejections
  @@index([isFlagged])                   // filter flagged log entries
  @@index([topicCategory])               // filter by fiqhi category
  @@index([errorStatus])                 // filter by error status
  @@index([rating])                      // filter by user feedback rating
  @@map("ai_assistant_logs")
}

// ==========================================
// 8. RAG KNOWLEDGE BASE
// ==========================================

// ── 8a. RAG Documents ─────────────────────
// Top-level source documents ingested into the RAG knowledge base.
// Each document corresponds to one approved Zufishan content source.
model RagDocument {
  id         String        @id @default(cuid())
  sourceType RagSourceType

  // Optional FK to a platform entity (e.g., Course)
  sourceId   String? // e.g., Course.id for COURSE_METADATA

  title    String  // Human-readable title for citation
  content  String  // Full raw text (used during ingestion only)
  url      String? // Deep-link into the platform UI (optional)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chunks RagChunk[]

  @@index([sourceType, isActive])
  @@index([sourceId])
  @@map("rag_documents")
}

// ── 8b. RAG Chunks ────────────────────────
// Text chunks derived from RagDocuments. Each chunk carries its
// embedding vector (stored as JSONB float array) for semantic search.
model RagChunk {
  id         String      @id @default(cuid())
  documentId String
  document   RagDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  chunkIndex Int    // 0-based position within the parent document
  content    String // The raw text of this chunk

  // Embedding stored as JSON array of floats (e.g. 768-dim Gemini embedding)
  // Cosine similarity is computed in-application over a pre-filtered candidate set.
  embedding  Json

  tokenCount Int? // Approximate token count of this chunk

  createdAt DateTime @default(now())

  @@unique([documentId, chunkIndex]) // one chunk per index per document
  @@index([documentId])
  @@map("rag_chunks")
}
