# Server
NODE_ENV=development
PORT=4000

CLIENT_URL=http://localhost:3000


# Auth
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
PAYMENT_WEBHOOK_SECRET=replace-with-a-random-secret-at-least-32-characters


# Local PostgreSQL / pgAdmin connection
DATABASE_URL="postgresql://postgres:<POSTGRES_PASSWORD>@localhost:5432/ranenla_dev?schema=public"

DIRECT_URL="postgresql://postgres:<POSTGRES_PASSWORD>@localhost:5432/ranenla_dev?schema=public"
SHADOW_DATABASE_URL="postgresql://postgres:<POSTGRES_PASSWORD>@localhost:5432/ranenla_shadow?schema=public"

# AI Assistant (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Market Price APIs (Zakat Nisab live metal rates)
GOLDAPI_KEY=your_goldapi_key_here
METALPRICEAPI_KEY=your_metalpriceapi_key_here

